# Supabase Configuration
# IMPORTANT: Use ONLY the public anonymous key (anon key) in the browser.
# NEVER expose the Supabase service role key in the frontend!
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# FixMyCity Express Backend API Base URL (including /api/v1 prefix)
# Local development default: http://localhost:5001/api/v1
# Production on Render: https://fixmycity-fvfg.onrender.com/api/v1
VITE_API_BASE_URL=http://localhost:5001/api/v1

