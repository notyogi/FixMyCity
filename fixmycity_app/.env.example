SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_UPLOAD_PRESET=your-unsigned-upload-preset

# Express Backend API URL
# Note: 10.0.2.2 is the special alias Android emulators use to reach "localhost"
# on the host machine. iOS simulators can use "localhost" directly instead.
BACKEND_API_URL=http://10.0.2.2:5001
