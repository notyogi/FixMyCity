# Supabase PostgreSQL Connection Strings
# Pooled connection string (port 6543 with pgbouncer) used for runtime queries
DATABASE_URL=

# Direct connection string (port 5432) used for Prisma migrations
DIRECT_URL=

# Supabase Auth configuration
SUPABASE_URL=https://[ref].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Server configuration
PORT=5001

# Admin User IDs (comma-separated UUIDs, temporary mechanism until role-based access exists)
ADMIN_USER_IDS=your-admin-user-uuid-1,your-admin-user-uuid-2

# Duplicate Detection Engine - Maximum bit difference for pHash similarity (0-64)
# Lower values (e.g. 5) = stricter matching (fewer false merges, but more missed duplicates)
# Higher values (e.g. 12-15) = looser matching (more merges, higher risk of merging unrelated issues)
DEDUP_HAMMING_THRESHOLD=10

# Priority Scoring Configuration
# Note: These values are tunable and intended to be adjusted after testing in your municipality.
# Weight applied to severity level (LOW=1, MEDIUM=2, HIGH=3, CRITICAL=4)
PRIORITY_SEVERITY_WEIGHT=10

# Weight applied per unique citizen confirmation
PRIORITY_CONFIRMATION_WEIGHT=3

# Additional weight added if any report in cluster is near a sensitive location (school, hospital, etc.)
PRIORITY_LOCATION_RISK_WEIGHT=15

# Weight applied per day since oldest report was created
PRIORITY_AGE_WEIGHT=0.5

# Maximum confirmation count considered for scoring (stops older popular issues from dominating)
PRIORITY_CONFIRMATION_CAP=10

# Maximum days open considered for scoring (prevents infinite growth for lingering low-priority issues)
PRIORITY_AGE_CAP_DAYS=30

# Priority Queue - Cache freshness interval in minutes
# Recomputes cluster priority scores if last recomputed more than this many minutes ago
PRIORITY_REFRESH_MINUTES=15

# CORS Allowed Origins (comma-separated list of web clients)
# Example: http://localhost:5173,https://your-dashboard.vercel.app
# If unset, the backend defaults to permissive mode (useful for local development).
# Remember to configure this in your Render environment variables when deploying!
CORS_ORIGINS=http://localhost:5173,https://your-dashboard.vercel.app

# Citizen Reputation System Deltas
# Reputation points awarded to the reporter when their report is marked FIXED
REP_FIXED_DELTA=1
# Reputation points deducted from the reporter when an admin rejects their report as spam/invalid
REP_REJECTED_DELTA=-1
# Reputation points awarded to the original reporter when a different citizen's duplicate merges into their cluster
REP_CONFIRMED_DELTA=1

# Rate Limiting Configuration (Anti-Spam & Abuse Safety Net)
# Remember to configure these environment variables in your Render service dashboard!
# Maximum report submissions allowed per user per rolling 1-hour window (default: 10)
REPORT_LIMIT_PER_HOUR=10
# Stricter report limit applied to flagged users with reputation_score < 0 (default: 3)
REPORT_LIMIT_FLAGGED_PER_HOUR=3
# Global coarse per-IP rate limit max requests across public API endpoints (default: 300)
RATE_LIMIT_IP_MAX=300
# Window in minutes for global per-IP rate limiter (default: 15)
RATE_LIMIT_IP_WINDOW_MINUTES=15




